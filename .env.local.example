# =============================================================
# VARIAVEIS DE AMBIENTE — copie este arquivo para .env.local
# e preencha com os valores reais do seu projeto Supabase.
#
# CHAVES PUBLICAS (seguro expor ao navegador via NEXT_PUBLIC_)
# ---------------------------------------------------------
# O Supabase usa essas chaves no cliente. A seguranca dos dados
# e garantida pelas politicas de RLS no banco de dados.
# =============================================================

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# =============================================================
# CHAVE SECRETA — NAO adicione isso ao codigo nem ao frontend
# ---------------------------------------------------------
# A service_role ignora o RLS e tem acesso total ao banco.
# Se precisar usar em Server Actions ou API Routes, adicione
# aqui SEM o prefixo NEXT_PUBLIC_ e acesse SOMENTE no servidor.
# =============================================================

# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
